{
  "name": "invincible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/di-gate.mjs && node scripts/drizzle-journal-gate.mjs && vitest run",
    "test:changed": "vitest run --changed",
    "test:di-gate": "node scripts/di-gate.mjs",
    "test:drizzle-journal": "node scripts/drizzle-journal-gate.mjs",
    "typecheck": "tsc --noEmit",
    "fetch-harness": "node scripts/fetch-harness-artifact.mjs",
    "prebuild": "node scripts/fetch-harness-artifact.mjs",
    "sandbox:start": "node sandbox/server.mjs",
    "test:sandbox": "vitest run sandbox",
    "db:generate": "npx --yes drizzle-kit@0.31.10 generate",
    "db:migrate": "node scripts/drizzle-journal-gate.mjs && npx --yes drizzle-kit@0.31.10 migrate",
    "smoke:tenancy": "node scripts/smoke-tenancy-public.mjs",
    "db:backfill-deks": "tsx scripts/backfill-tenant-deks.ts",
    "backfill:sessions": "tsx scripts/backfill-sessions.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.25",
    "@vercel/blob": "^2.8.0",
    "@vercel/sandbox": "^3.0.0",
    "ai": "^7.0.52",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "mathjax-full": "^3.2.2",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^4.7.1",
    "workflow": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  },
  "license": "MIT",
  "description": "In-browser agent harness (Zig/dvui Wasm + Next.js host, Vercel AI Gateway)"
}
