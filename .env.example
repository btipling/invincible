# Inference (Vercel project env + local .env.local)
# Create at: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# DEFAULT_MODEL=xai/grok-4.1-fast-non-reasoning

# Harness Wasm artifact (Vercel prebuild / npm run fetch-harness)
# HARNESS_ARTIFACT_TOKEN=   # fine-grained PAT: Actions Read on the artifact repo
# HARNESS_OWNER=            # optional override (default: Vercel/GitHub git owner)
# HARNESS_REPO=             # optional override (default: Vercel/GitHub git repo name)
# HARNESS_SKIP_FETCH=0
# HARNESS_REQUIRE=          # default: required on Vercel
# HARNESS_ARTIFACT_ID=
# HARNESS_COMMIT_SHA=
# HARNESS_WAIT_MS=
# HARNESS_WAIT_GRACE_MS=
# HARNESS_POLL_MS=

# Agent sandbox (server-only — never NEXT_PUBLIC_*)
# Phase 2+: POST /api/agent tools. Host falls back to /api/chat on 503.
# SANDBOX_URL=http://127.0.0.1:8787
# SANDBOX_TOKEN=
# AGENT_MAX_STEPS=6
# AGENT_MODEL=   # optional tool-capable model override (provider/model)

# --- Multi-tenant auth phase 1 (Postgres + seed; no HTTP gate yet) ---
# Prefer a pooled connection string on Vercel (Neon pooler / PgBouncer).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
#
# AES-256-GCM key: 32 raw bytes, base64-encoded (openssl rand -base64 32)
# CREDENTIALS_ENCRYPTION_KEY=
#
# Seed bootstrap (npm run db:seed) — never commit real values
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# Optional overrides; else SANDBOX_URL / SANDBOX_TOKEN
# SEED_SANDBOX_URL=
# SEED_SANDBOX_TOKEN=
#
# Auth.js (phase 2 — not required for phase 1 migrate/seed):
# AUTH_SECRET=
