# Inference (Vercel project env + local .env.local)
# Create at: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Harness Wasm artifact (Vercel prebuild / npm run fetch-harness)
# HARNESS_ARTIFACT_TOKEN=   # fine-grained PAT: Actions Read on the artifact repo
# HARNESS_OWNER=            # optional override (default: Vercel/GitHub git owner)
# HARNESS_REPO=             # optional override (default: Vercel/GitHub git repo name)
# HARNESS_SKIP_FETCH=0
# HARNESS_REQUIRE=          # default: required on Vercel
# HARNESS_ARTIFACT_ID=
# HARNESS_COMMIT_SHA=
# HARNESS_WAIT_MS=
# HARNESS_WAIT_GRACE_MS=
# HARNESS_POLL_MS=

# Agent sandbox (server-only — never NEXT_PUBLIC_*)
# Product tool turns resolve sandbox from DB grants, not these env vars.
# SANDBOX_URL/SANDBOX_TOKEN are used for the local BYO daemon only; a missing
# grant + no alternate tools is a 403 (no 503 → chat fallback in the product).
# SANDBOX_URL=http://127.0.0.1:8787
# SANDBOX_TOKEN=
# Optional tool-loop safety ceiling (1…256). Omit for model-ended loop + user Stop.
# AGENT_MAX_STEPS=32
# AGENT_REASONING=  # optional ops override: provider-default | none | low | medium | high
#   Product default for reasoning-capable models is `low` (not vendor max /
#   provider-default). This env is not the operator UI; omit it on origin.
#   When unset, reasoning is enabled only if the model looks reasoning-capable.
#
# Sandbox daemon ONLY (the BYO `sandbox/server.mjs` process — NOT Vercel env).
# Daemon version gate is always-on client-side; auto-update is opt-in so static/binary/BYO
# installs stay free of git requirements. When enabled, the daemon `git fetch` + ff-only
# merges SANDBOX_GIT_DIR then exits 0 for the supervisor (Restart=always) to reload.
# See docs/sandbox.md §3. Fails closed on divergent/dirty checkouts (stays up, keeps 426).
# SANDBOX_AUTO_UPDATE=1
# SANDBOX_GIT_DIR=/path/to/invincible/checkout
# SANDBOX_GIT_REF=origin/main   # passed to git merge after `--` (a dash-prefixed ref is never a git option)
# SANDBOX_UPDATE_CHECK_MS=60000   # 0 disables the background timer (header-trigger only); negative/non-numeric fail closed to 60000
# Auto-update is single-flight: the timer and a request-triggered restart never run concurrently.

# Builtin HTTPS fetch (server-only — never NEXT_PUBLIC_*)
# Always-available: http_get/http_head are attached when the user has a running HTTP
# instance (create one under Settings → Sandbox). Attach-only; never create-on-turn.
# Requires Vercel Sandbox entitlement + OIDC on the deploy.
# See docs/builtin-http.md
# BUILTIN_HTTP_TIMEOUT_MS=120000
# BUILTIN_HTTP_MAX_BYTES=2097152
# Legacy env still parsed by builtinHttpConfig (not used for attach create; idle = 30m family):
# BUILTIN_HTTP_SANDBOX_TIMEOUT_MS=1800000


# --- Redis multi-session store (Phase 1 seam, server-only — never NEXT_PUBLIC_*) ---
# Optional BYO Redis. The store uses the node-redis RESP client and reads a single
# `REDIS_URL` in wire format, exactly what the Vercel/Upstash Redis integration
# provisions (redis:// or rediss:// for TLS):
#   REDIS_URL=redis://default:<secret>@<host>:<port>
# A missing/unreachable REDIS_URL makes the /api/sessions* endpoints return
# 503 SESSION_STORE_UNAVAILABLE (fail-closed: bounded connect + offline queue disabled —
# never a serverless hang nor a 500); nothing else in the app is affected.
# Migration: the pre-switch SESSION_REDIS_* / UPSTASH_REDIS_REST_* names are REMOVED. If
# any are still set, the store logs a one-time deprecation hint then 503s until you set
# REDIS_URL (the old REST credentials were protocol-incompatible with the RESP client).
#   REDIS_URL=redis://default:<secret>@<host>:<port>   # or rediss:// for TLS
# TTL refreshed on WRITE only (put sets EX) — not "idle since last read". 0 = no expiry.
# SESSION_REDIS_TTL_MS=0
#   Never log REDIS_URL / opt into a debug path that prints it — it embeds the credential.
#   Secret == ops-side only.


# --- Blob transcript store (Phase 0 #515, server-only — never NEXT_PUBLIC_*) ---
# Optional Vercel Blob (S3-backed) for the session **transcript** (the only large
# surface). Redis keeps the small envelope; the transcript lives in append-only Blob
# objects, uploaded **client→Blob** through a server-minted short-lived scoped URL —
# never a fat body through a Function (4.5 MiB payload ceiling).
# BLOB_READ_WRITE_TOKEN=
#   When unset, the app falls back to an in-memory transcript store (dev/tests only);
#   Production must set the token. Configured via the GHA/env manager, never a laptop
#   ritual (documented seam — no Production data/secret mutate). BYO S3/R2 operators
#   swap the store behind the same seam (see docs/bring-your-own.md).
#   Never log the token — it is the server's Blob credential.
#
# Optional public host flag (NOT the server credential — never set BLOB_READ_WRITE_TOKEN
# client-side): opt the DOM host onto the envelope+Blob carrier instead of the one-shot
# full-record PUT. Roll-forward is the default while host call sites move over.
# NEXT_PUBLIC_HARNESS_CARRIER_ENVELOPE=


# --- Tenant BYOK inference (when tenancy triple is ON) ---
# Provider API keys are NOT env vars. Admins configure them under /admin/inference
# (ciphertext under tenant DEK). AI_GATEWAY_API_KEY above is still required for
# Gateway routing — it is not a substitute for tenant provider keys.
# Schema-only migrate for provider tables: GitHub Actions workflow db-migrate
# (confirm=migrate). See docs/bring-your-own.md §4a Inference keys.
#
# --- Multi-tenant auth (REQUIRED — tenancy is hard-on) ---
# Tenancy requires ALL THREE of DATABASE_URL + AUTH_SECRET + CREDENTIALS_ENCRYPTION_KEY.
# Without the triple, the login wall + fail-closed auth still apply for all
# pages and protected APIs (see docs/bring-your-own.md §4a).
# Prefer a pooled connection string on Vercel (Neon pooler / PgBouncer).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
#
# Auth.js — generate: openssl rand -base64 32
# Set AUTH_SECRET after migrate + the first-run sign-up bootstrap (the tenancy
# triple must be complete before the login wall is active).
# AUTH_SECRET=

# Optional generic OIDC SSO — all three required to enable (feature-env only).
# Provider id is `oidc`. Production callback: {origin}/api/auth/callback/oidc
# No tenancy triple-gate: the provider registers whenever these three are set.
# AUTH_OIDC_ISSUER=https://your-idp.example/realms/app
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_LABEL=Sign in with SSO
#
# Optional SCIM 2.0 Users API — enabled when SCIM_BEARER_TOKEN is non-empty (feature-env only).
# Base path: /api/scim/v2  ·  Authorization: Bearer <token>
# Fail-closed: unset token → 404. Hybrid: SCIM list = SCIM-managed only; /admin shows all sources.
# SCIM_BEARER_TOKEN=
#
# AES-256-GCM application master key (AMK): 32 raw bytes, base64-encoded
# (openssl rand -base64 32). Wraps per-tenant DEKs; sandbox tokens encrypt under DEK.
# Do not casually reuse Production AMK on public Preview deployments.
# CREDENTIALS_ENCRYPTION_KEY=
#
# Token decrypt cutover. Default when unset: dual (DEK then AMK).
# Deploy dual → GHA db-tenancy-backfill-deks (confirm=backfill; job sets
# ALLOW_TENANT_DEK_BACKFILL=1) → verify → then dek-only.
# Never set dek-only on Production until backfill is verified (lockout risk).
# TENANT_TOKEN_DECRYPT_MODE=dual
# TENANT_TOKEN_DECRYPT_MODE=dek-only
#
# No fourth env for DEKs. Owner rotates tenant DEK from /admin (re-encrypts tokens).
# Do not change Production CREDENTIALS_ENCRYPTION_KEY (AMK) without a re-wrap tool.
# Existing data backfill: GHA db-tenancy-backfill-deks — not seed; allow flag is job-only.
#
# First-run bootstrap: a tenant-less DB self-bootstraps in the browser — open
# /login after db-migrate and a sign-up form creates the first tenant + owner
# (no seed env, no laptop). After sign-up the owner creates a sandbox at
# /admin/sandboxes; agent turns fail closed until one exists. Existing tenanted
# DBs are unaffected — they never show the sign-up form.
#
# --- Durable-turn wall clock (plan #923) — cache/probe seams ONLY, never enforcement ---
# The 1-hour cap value itself is CODE (`TURN_WALL_CLOCK_MAX_MS = 3_600_000` in
# lib/sessionCloudCaps.ts), human-authorized — there is NO env override for it (a
# dynamic value would itself need a human gate). The wall wrap-up substitute bound
# (`TURN_WALL_CLOCK_WRAPUP_MAX_MS = 300_000`) is also CODE: wall wrap-up is 1h-exempt
# so it can complete after the cap, but it is not unbounded (deadlineAt + 5 min,
# not a fresh Date.now()+5min per retry; no operator xhigh CoT — adversarial-review #926).
# The 512-step wrap-up does not inherit this bound, but it still carries the 1h
# deadlineAt signal. The TTL/probe knobs below are
# documented operator seams for a future read-side deadline cache and a live
# elapsed context-slot probe; setting them NEVER changes the enforcement
# deadline (which always uses workflowStartedAt + the code cap).
# TURN_WALL_CLOCK_DEADLINE_TTL_MS=60000
# TURN_WALL_CLOCK_PROBE_EVERY_MS=2000
